[Unit]
Description=AppGather personal web launcher
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/AppGather
ExecStart=/usr/bin/node /opt/AppGather/backend/server.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3050
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
